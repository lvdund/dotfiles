set $mod Mod4
set $term kitty
set $menu fuzzel
set $browser firefox

font pango:FiraCode Nerd Font 12

# Pure black background (no wallpaper image)
output * bg #000000 solid_color
output * dpms on

# Neon grey window appearance
default_border pixel 2
default_floating_border pixel 2

client.focused          #d8d8d8 #080808 #eeeeee #d8d8d8 #d8d8d8
client.focused_inactive #303030 #080808 #8a8a8a #303030 #303030
client.unfocused        #161616 #080808 #555555 #161616 #161616
client.urgent           #f8f8f8 #080808 #f8f8f8 #f8f8f8 #f8f8f8

# Compact gaps
gaps inner 4
gaps outer 2
# smart_gaps on

# Keyboard
bindsym $mod+t exec $term
bindsym $mod+b exec $browser
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Focus movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resize focused window width
bindsym $mod+minus resize shrink width 20 px
bindsym $mod+equal resize grow width 20 px

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

bindsym $mod+Page_Up workspace prev
bindsym $mod+Page_Down workspace next

# Mouse
floating_modifier $mod normal

# Float extension dialogs and volume control windows
for_window [title="(?i).*(Extension:|Volum(?:e|n) Control).*"] floating enable

# Waybar
exec waybar

# Disable automatic display blanking
# Do not launch swayidle or any DPMS timeout script

# Include Debian's optional system config snippets
include /etc/sway/config.d/*
